# ===== Anthropic (Claude) =====
ANTHROPIC_API_KEY=sk-ant-...
# Modelos atuais: claude-sonnet-5-5 (qualidade) ou claude-haiku-5-5 (mais barato).
# Os antigos claude-3-5-sonnet-latest / claude-3-5-haiku foram aposentados.
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high  (mais alto = mais cuidadoso e mais caro)
CLAUDE_EFFORT=medium
# Se o Claude recusar um texto por política de segurança, refaz automaticamente
# no modelo de fallback recomendado pela Anthropic (só Sonnet/Opus).
CLAUDE_FALLBACK=true

# ===== Onde publicar =====
# github = site estático Mauá 360 (Cloudflare Pages); wordpress = WordPress via REST API
PUBLISHER=github

# ===== GitHub (site estático) =====
# Repositório do site, no formato usuario/maua360
GITHUB_REPO=seuusuario/maua360
# Token "fine-grained" só para esse repositório, com Contents e Pull requests em Read and write
GITHUB_TOKEN=github_pat_...
GITHUB_BASE_BRANCH=main

# ===== WordPress (só se PUBLISHER=wordpress) =====
WP_URL=https://seuportal.com.br
WP_USER=usuario_editor
# Usuários > Perfil > Senhas de aplicativo (pode colar com os espaços)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Cria a categoria/tag no WP se ainda não existir
WP_CREATE_MISSING_TERMS=true

# ===== Agente =====
DB_PATH=data/noticias.db
SOURCES_FILE=sources.json
LOG_FILE=logs/agente.log
LOG_LEVEL=INFO
# Máximo de matérias enviadas ao Claude por execução (controle de custo)
MAX_ARTICLES_PER_RUN=10
# Quantas pautas só do Grande ABC (sem Mauá) entram por execução, como complemento
MAX_ABC_PER_RUN=1
# Pontuação mínima do filtro de relevância (ver relevance.py)
MIN_RELEVANCE_SCORE=3
# Ignora matérias mais antigas que N horas (0 = não filtra)
MAX_AGE_HOURS=48
# Intervalo do modo --loop, em minutos
LOOP_INTERVAL_MINUTES=30
REQUEST_TIMEOUT=20
USER_AGENT=Maua360Bot/1.0 (+https://maua360.com.br/contato)
